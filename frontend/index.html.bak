<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart E-Commerce — Premium Full-Stack Platform</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header -->
    <header class="header">
        <div class="header-content">
            <a href="#" class="brand">
                <div class="brand-badge">⚡</div>
                <span>SmartCommerce</span>
            </a>

            <div class="search-bar">
                <input type="text" id="searchInput" placeholder="Search catalog (e.g. Headphones, MacBook, Keyboard)...">
            </div>

            <div class="header-actions">
                <!-- User Account Button -->
                <button id="authBtn" class="btn btn-outline" onclick="openAuthModal()">
                    <span id="authStatusText">Sign In</span>
                </button>

                <!-- Notifications Button -->
                <div class="notif-btn-wrapper">
                    <button class="icon-btn" onclick="toggleNotifications()" title="Notifications">
                        🔔
                        <span id="notifBadge" class="badge-count hidden">0</span>
                    </button>
                </div>

                <!-- Cart Button -->
                <button class="cart-btn" onclick="toggleCartDrawer()">
                    🛒 Cart
                    <span id="cartCountBadge" class="badge-count">0</span>
                </button>

                <!-- Admin Link -->
                <a href="http://127.0.0.1:8002/admin/dashboard/" target="_blank" class="btn btn-admin">
                    📊 Admin Panel
                </a>
            </div>
        </div>
    </header>

    <!-- Notification Toast Container -->
    <div id="toastContainer" class="toast-container"></div>

    <!-- Notifications Drawer -->
    <div id="notifDrawer" class="drawer">
        <div class="drawer-header">
            <h3>Live Notifications (WebSocket)</h3>
            <button class="close-btn" onclick="toggleNotifications()">✕</button>
        </div>
        <div id="notifList" class="notif-list">
            <p class="empty-state">No new notifications</p>
        </div>
    </div>

    <!-- Main Container -->
    <main class="main-container">
        <!-- Hero Banner -->
        <section class="hero-banner">
            <div class="hero-text">
                <div class="hero-tag">🔥 Production-Ready E-Commerce Stack</div>
                <h1>Smart Catalog & Real-Time Commerce</h1>
                <p>FastAPI async microservices, Stripe Payments, WebSocket real-time alerts, and Django analytics dashboard.</p>
            </div>
            <div class="hero-quick-auth">
                <span>Quick Switch Demo User:</span>
                <div class="quick-user-pills">
                    <button class="pill active" onclick="quickLogin('customer@example.com', 'Customer')">Customer (Alice)</button>
                    <button class="pill" onclick="quickLogin('staff@example.com', 'Staff')">Staff User</button>
                    <button class="pill" onclick="quickLogin('admin@example.com', 'Admin')">Admin User</button>
                </div>
            </div>
        </section>

        <!-- Filters Section -->
        <section class="filter-section">
            <div class="filter-group">
                <label>Category:</label>
                <select id="categorySelect" onchange="fetchProducts()">
                    <option value="">All Categories</option>
                    <option value="Electronics">Electronics</option>
                    <option value="Accessories">Accessories</option>
                    <option value="Apparel">Apparel</option>
                    <option value="Home">Home</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Max Price ($<span id="priceDisplay">1500</span>):</label>
                <input type="range" id="priceRange" min="20" max="1500" step="10" value="1500" oninput="updatePriceFilter(this.value)">
            </div>

            <div class="filter-group checkbox-group">
                <label>
                    <input type="checkbox" id="inStockCheck" onchange="fetchProducts()"> In-Stock Only
                </label>
                <label>
                    <input type="checkbox" id="sortPopularityCheck" onchange="fetchProducts()"> Sort by Popularity
                </label>
            </div>
        </section>

        <!-- Product Grid -->
        <section class="catalog-section">
            <div id="productGrid" class="product-grid">
                <!-- Injected via JS -->
            </div>
        </section>
    </main>

    <!-- Cart Drawer -->
    <div id="cartDrawer" class="drawer right-drawer">
        <div class="drawer-header">
            <h3>Your Shopping Cart</h3>
            <button class="close-btn" onclick="toggleCartDrawer()">✕</button>
        </div>

        <div id="cartItemsContainer" class="cart-items-container">
            <p class="empty-state">Your cart is currently empty.</p>
        </div>

        <div class="cart-summary">
            <div class="summary-row">
                <span>Subtotal</span>
                <span id="cartSubtotal">$0.00</span>
            </div>
            <div class="summary-row">
                <span>Estimated Tax (8%)</span>
                <span id="cartTax">$0.00</span>
            </div>
            <div class="summary-row grand-total">
                <span>Grand Total</span>
                <span id="cartGrandTotal">$0.00</span>
            </div>
            <button id="checkoutBtn" class="btn btn-checkout" onclick="initiateCheckout()">
                💳 Proceed to Stripe Checkout
            </button>
        </div>
    </div>

    <!-- Auth Modal -->
    <div id="authModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modalTitle">Account Login</h3>
                <button class="close-btn" onclick="closeAuthModal()">✕</button>
            </div>
            <form id="authForm" onsubmit="handleAuthSubmit(event)">
                <div class="form-group" id="nameGroup" style="display: none;">
                    <label>Full Name</label>
                    <input type="text" id="authName" placeholder="Your name">
                </div>
                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" id="authEmail" required value="customer@example.com">
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" id="authPassword" required value="Password123!">
                </div>
                <button type="submit" class="btn btn-primary btn-block" id="submitAuthBtn">Sign In</button>
            </form>
            <button type="button" class="btn btn-outline btn-block" onclick="loginWithGoogle()" style="margin-top: 10px;">
                🔵 Sign in with Google
            </button>
            <div class="modal-footer">
                <p id="toggleAuthModeText">
                    Don't have an account? <a href="#" onclick="toggleAuthMode(true)">Create one</a>
                </p>
            </div>
        </div>
    </div>

    <script src="https://cdn.auth0.com/js/auth0-spa-js/2.1/auth0-spa-js.production.js"></script>
    <script src="app.js"></script>
</body>
</html>